{
  "name": "tauri-zero",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "tauri:dev": "node scripts/tauri.mjs development dev",
    "tauri:test": "node scripts/tauri.mjs test dev",
    "tauri:prod": "node scripts/tauri.mjs production dev",
    "tauri:build": "node scripts/tauri.mjs production build",
    "tauri:build:dev": "node scripts/tauri.mjs development build",
    "tauri:build:test": "node scripts/tauri.mjs test build",
    "tauri": "tauri",
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "tsc && vite build",
    "build:test": "tsc && vite build --mode test",
    "build:prod": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:test": "node scripts/cargo-test.mjs",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "dev:env": "node scripts/dev-frontend.mjs",
    "build:env": "node scripts/build-frontend.mjs",
    "devtools": "react-devtools",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "~2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-notification": "~2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-shell": "~2",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "antd": "6.6.2",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router": "8.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.5.0",
    "modern-normalize": "^3.0.1",
    "prettier": "^3.9.6",
    "react-devtools": "^8.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.104.1",
    "simple-git-hooks": "^2.11.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,html,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "src-tauri/**/*.rs": [
      "rustfmt --edition 2021"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no-install commitlint --edit \"$1\""
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
