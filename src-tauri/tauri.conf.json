{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-zero",
  "version": "0.3.0",
  "identifier": "com.liang.tauri-zero",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tauri-zero",
        "width": 800,
        "height": 600
      },
      {
        "label": "tray-popup",
        "url": "index.html#/tray-popup",
        "width": 200,
        "height": 200,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https:",
      "devCsp": "default-src 'self' http://localhost:1420; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:8097; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ws://localhost:1421 http://localhost:1420 http://localhost:8097 ws://localhost:8097 https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFMkM3MjA3MDgyMDkyODgKUldTSWtpQUlCM0lzenRRbDlQanpzRXREOUV0NTcwdEU1TGVra0pvSVhIZk45TUl3VDM5T2pRWjgK",
      "endpoints": [
        "https://github.com/TheShining/tauri-zero/releases/latest/download/{{target}}-{{arch}}.json"
      ]
    }
  }
}
